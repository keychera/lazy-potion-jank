(ns bermain.dev
  (:require
   [bermain.sdl3.sdl3 :as sdl3]))

(defonce stop-atom (atom false))
(defn toggle-stop []
  ;; encountered this bug regarding this defn
  ;; https://clojurians.slack.com/archives/C03SRH97FDK/p1789329083393359
  (if (swap! stop-atom not)
    "stopping game..."
    "starting game!"))

(defn dev []
  (future
    (while true
      (try
        (when (not @stop-atom)
          (#'sdl3/main {:stop-atom stop-atom})
          (reset! stop-atom true))
        (catch cpp/jank.runtime.object_ref e
          (println :caught e))))))

(defonce _ (dev))

(comment
  (toggle-stop)

  ::waiting-for-something-to-happen?)

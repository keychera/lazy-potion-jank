{:paths ["."]
 :tasks {prep     {:task (exec 'build.lets/prep)}
         jank     {:task (exec 'build.lets/jank)}
         repl-dev {:task (exec 'build.lets/repl-dev)}
         compile  {:task (exec 'build.lets/compile-jank)}
         lets (let [[action] *command-line-args*]
                (exec (symbol "build.lets" action)))}}

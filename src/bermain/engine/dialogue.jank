(ns bermain.engine.dialogue
  (:require
   [bermain.engine.audio :as audio]
   [bermain.engine.time :as time]
   [bermain.engine.utils :refer [query-one s->]]
   [bermain.engine.world :as world :refer [esse]]
   [bermain.sdl3.text :as text]
   [odoyle.rules :as o]))

(defn dialogue->piece 
  [^(:* cpp/TTF_TextEngine) engine
   ^(:* cpp/TTF_Font) font 
   dialogue-str]
  (let [TTF_Text (cpp/TTF_CreateText engine font dialogue-str 0)
        w (cpp/int) h (cpp/int)
        _        (cpp/TTF_GetTextSize TTF_Text (cpp/& w) (cpp/& h))]
    {:TTF_Text (cpp/box TTF_Text)
     :dialogue dialogue-str
     :length   (count dialogue-str)
     :text-w   w}))

(defn break-dialogues [engine font dialogue]
  (cond
    (string? dialogue)
    [(dialogue->piece engine font dialogue)]

    (vector? dialogue)
    (reduce (fn dialouge-reducer [acc d]
              (if (vector? d)
                (conj acc (dialogue->piece engine font (first d)))
                (conj acc (dialogue->piece engine font d))))
            [] dialogue)

    :else [(dialogue->piece engine font (str dialogue))]))

(defn merge-two-dialogue [a b]
  (letfn [(ensure-vec [dialogue]
            (if (vector? dialogue) dialogue [dialogue]))]
    (into (ensure-vec a) (ensure-vec b))))

(defn count-dialogue [dialogue]
  (cond
    (string? dialogue) (count dialogue)

    (vector? dialogue)
    (reduce (fn dialouge-reducer [acc d]
              (if (vector? d)
                (+ acc (count (first d)))
                (+ acc (count d))))
            0 dialogue)

    :else (count (str dialogue))))

(def rules
  (o/ruleset
   {::dialogue-tick
    [:what
     [::time/now ::time/delta dt]
     [::time/now ::tick-length tick-length {:then false}]
     [::time/now ::tick-progress tick-progress {:then false}]
     [::time/now ::tick tick {:then false}]
     :then
     (if (< tick-progress tick-length)
       (s-> session (o/insert ::time/now ::tick-progress (+ tick-progress dt)))
       (s-> session (o/insert ::time/now {::tick-progress 0
                                          ::tick (inc tick)})))]

    ::dialogue-play
    [:what
     [::time/now ::play the-play]
     [::time/now ::play-progress play-progress]
     [::time/now ::dialogue prev-dialogue {:then false}]
     :then
     (let [{:keys [players scripts]} the-play]
       (when-let [[player-key dialogue & attributes] (get scripts play-progress)]
         (let [player            (get players player-key)
               attrs-set         (set attributes)
               dialogue          (if (:+ attrs-set) (merge-two-dialogue prev-dialogue dialogue) dialogue)
               dialogue-progress (if (:+ attrs-set) (count-dialogue prev-dialogue) 0)]
           (s-> session
                (o/insert ::time/now
                          {::player            player
                           ::dialogue          dialogue
                           ::dialogue-length   (count-dialogue dialogue)
                           ::dialogue-progress dialogue-progress})))))]

    ::next-dialogue
    [:what
     [esse-id ::control ::next-dialogue]
     [esse-id ::play-progress play-progress {:then false}]
     :then
     (s-> session (o/insert esse-id {::play-progress (inc play-progress)}))]

    ::break-dialogue
    [:what
     [:global ::text/engine engine]
     [:global ::text/font font]
     [esse-id ::dialogue dialogue]
     :then
     (let [dialogue-pieces (break-dialogues engine font dialogue)]
       (s-> session
            (o/insert esse-id {::dialogue-pieces dialogue-pieces})))]

    ::animate-dialogue
    [:what
     [::time/now ::tick tick]
     [esse-id ::player player]
     [esse-id ::dialogue-pieces dialogue-pieces]
     [esse-id ::dialogue-length dialogue-length]
     [esse-id ::dialogue-progress progress {:then false}]
     :then
     (when (<= progress dialogue-length)
       (s-> session
            (o/insert esse-id ::dialogue-progress (inc progress))
            (o/insert :dialogue ::audio/play-tututu (< progress dialogue-length))))]}))

(defn init-fn [world {:keys [::text/engine ::text/font]}]
  (-> world
      (esse :global {::text/engine engine
                     ::text/font font})
      (esse ::time/now {::tick 0 ::tick-progress 0})))

(defn render!
  [{world ::world/this :as game}]
  (when-let [{:keys [player dialogue-pieces progress]} (query-one world ::animate-dialogue)]
    (let [text     (cpp/unbox (:* cpp/TTF_Text) (::text/text game))]
      (doto text
        (cpp/TTF_SetTextColor 255 255 255 cpp/SDL_ALPHA_OPAQUE)

        (cpp/TTF_SetTextString (-> player :name) 0)
        (cpp/TTF_DrawRendererText 30.0 260.0))
      (loop [[piece & remains] dialogue-pieces
             local-progress 0
             local-width 0]
        (when piece
          (let [{:keys [TTF_Text dialogue length text-w]} piece
                TTF_Text (cpp/unbox (:* cpp/TTF_Text) TTF_Text)
                current  (- progress local-progress)
                dialogue (subs dialogue 0 (min (max current 0) length))
                x-pos    (+ 30.0 local-width)]
            (doto TTF_Text
              (cpp/TTF_SetTextString dialogue 0)
              (cpp/TTF_DrawRendererText x-pos 290.0))
            (recur remains length (+ local-width text-w))))))))

(defn get-system []
  {::world/init-fn init-fn
   ::world/rules rules})

(def jank-play
  {:players {:NA {:name "NARRATOR"}
             :d  {:name "Dofida"}
             :nf {:name "Noifasui"}}
   :effects {:funky (fn [])}
   :scripts [[:d "oh."]
             [:d [" so this is " ["existence." :funky]] :+]
             [:d "for a language named jank,"]
             [:d "this doesn't feel janky at all."]
             [:nf "this is not jank"]
             [:d "WHAT?" :camera-shake]
             [:d " What do you mean this is not jank?!" :+]
             [:nf "This is ClojureScript"]
             [:NA "This man is lying for dramatic effect"]]})

(comment
  (require '[bermain.engine.world-mutator :refer [inject-facts! debug-tap]])

  (inject-facts!
   [::time/now {::tick-length 0.02
                ::dialogue ""
                ::dialogue-progress 0
                ::play jank-play
                ::play-progress 0}])

  (inject-facts! [::time/now {::control ::next-dialogue}])

  debug-tap

  :-)

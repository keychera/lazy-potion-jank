(ns bermain.engine.dialogue
  (:require
   [bermain.engine.macros :refer [s->]]
   [bermain.engine.time :as time]
   [bermain.engine.utils :as utils]
   [bermain.engine.world :as world :refer [esse]]
   [bermain.sdl3.text :as text]
   [odoyle.rules :as o]))

(defn dialogue->string [dialogue]
  (cond
    (string? dialogue)
    dialogue

    (vector? dialogue)
    (reduce (fn dialouge-reducer [acc d]
              (if (vector? d)
                (str acc (first d))
                (str acc d)))
            "" dialogue)

    :else (str dialogue)))

(defn merge-two-dialogue [a b]
  (letfn [(ensure-vec [dialogue]
            (if (vector? dialogue) dialogue [dialogue]))]
    (into (ensure-vec a) (ensure-vec b))))

(defn count-dialogue [dialogue]
  (cond
    (string? dialogue) (count dialogue)
  
    (vector? dialogue)
    (reduce (fn dialouge-reducer [acc d]
              (if (vector? d)
                (+ acc (count (first d)))
                (+ acc (count d))))
            0 dialogue)
  
    :else (count (str dialogue))))

(def rules
  (o/ruleset
   {::dialogue-tick
    [:what
     [::time/now ::time/delta dt]
     [::time/now ::tick-length tick-length {:then false}]
     [::time/now ::tick-progress tick-progress {:then false}]
     [::time/now ::tick tick {:then false}]
     :then
     (if (< tick-progress tick-length)
       (s-> session (o/insert ::time/now ::tick-progress (+ tick-progress dt)))
       (s-> session (o/insert ::time/now {::tick-progress 0
                                          ::tick (inc tick)})))]

    ::dialogue-play
    [:what
     [::time/now ::play the-play]
     [::time/now ::play-progress play-progress]
     [::time/now ::dialogue prev-dialogue {:then false}]
     :then
     (let [{:keys [players 
                   scripts]} the-play
           [player-key 
            dialogue
            & attributes]    (get scripts play-progress)
           player            (get players player-key)
           attrs-set         (set attributes)
           dialogue          (if (:+ attrs-set) (merge-two-dialogue prev-dialogue dialogue) dialogue)
           dialogue-progress (if (:+ attrs-set) (count-dialogue prev-dialogue) 0)]
       (tap> dialogue)
       (s-> session
            (o/insert ::time/now {::player            player
                                  ::dialogue          dialogue
                                  ::dialogue-progress dialogue-progress})))]

    ::next-dialogue
    [:what
     [esse-id ::control ::next-dialogue]
     [esse-id ::play-progress play-progress {:then false}]
     :then (s-> session (o/insert esse-id ::play-progress (inc play-progress)))]

    ::animate-dialogue
    [:what
     [::time/now ::tick tick]
     [esse-id ::player player]
     [esse-id ::dialogue dialogue]
     [esse-id ::dialogue-progress progress {:then false}]
     :then
     (s-> session (o/insert esse-id ::dialogue-progress (inc progress)))]}))

(defn init-fn [world _game]
  (-> world
      (esse ::time/now {::tick 0 ::tick-progress 0})
      (esse :one {::dialogue "hello jank!" ::dialogue-progress 0})))

(defn render!
  [{world ::world/this :as game}]
  (when-let [{:keys [dialogue progress]} (utils/query-one world ::animate-dialogue)]
    (let [dialogue-str (dialogue->string dialogue)
          dialogue     (subs dialogue-str 0 (min (max progress 0) (count dialogue-str)))
          text         (doto (cpp/unbox (:* cpp/TTF_Text) (::text/text game))
                         (cpp/TTF_SetTextString dialogue 0)
                         (cpp/TTF_SetTextColor 255 255 255 cpp/SDL_ALPHA_OPAQUE))]
      (cpp/TTF_DrawRendererText text 120.0 240.0))))

(defn get-system []
  {::world/init-fn init-fn
   ::world/rules rules})

(def dofida-play
  {:players {:d  {:name "dofida"}
             :nf {:name "noifasui"}}
   :effects {:funky (fn [])}
   :scripts [[:d "oh."]
             [:d [" so this is " ["existence." :funky]] :+]
             [:d "for a language named jank,"]
             [:d "this doesn't feel janky at all."]
             [:nf "this is not jank"]
             [:d "WHAT?" :camera-shake]
             [:d "What do you mean this is not jank?!" :+]
             [:nf "This is ClojureScript"]]})

(comment
  (require '[bermain.engine.world-mutator :refer [inject-facts! debug-tap]])

  debug-tap

  (inject-facts!
   [::time/now {::tick-length 0.02
                ::dialogue ""
                ::dialogue-progress 0
                ::play dofida-play
                ::play-progress 0}])

  (inject-facts! [::time/now {::control ::next-dialogue}])

  :-)

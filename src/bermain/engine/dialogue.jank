(ns bermain.engine.dialogue
  (:require
   [bermain.engine.macros :refer [s->]]
   [bermain.engine.time :as time]
   [bermain.engine.utils :as utils]
   [bermain.engine.world :as world :refer [esse]]
   [odoyle.rules :as o]))

(def rules
  (o/ruleset
   {::world-mutator
    [:what
     [::time/now ::time/delta dt]
     [::time/now ::world-mutator world-mutator]
     :then
     (when-let [mutator-fn @world-mutator]
       (reset! world-mutator nil)
       (s-> (mutator-fn session)))]

    ::dialogue-tick
    [:what
     [::time/now ::time/delta dt]
     [::time/now ::tick-length tick-length {:then false}]
     [::time/now ::tick-progress tick-progress {:then false}]
     [::time/now ::tick tick {:then false}]
     :then
     (tap> [tick-progress dt (< tick-progress tick-length)])
     (if (< tick-progress tick-length)
       (s-> session (o/insert ::time/now ::tick-progress (+ tick-progress dt)))
       (s-> session (o/insert ::time/now {::tick-progress 0
                                          ::tick (inc tick)})))]

    ::animate-dialogue
    [:what
     [::time/now ::tick tick]
     [esse-id ::dialogue dialogue]
     [esse-id ::progress progress {:then false}]
     :then
     (s-> session (o/insert esse-id ::progress (inc progress)))]}))


(defonce world-mutator (atom nil))

(defn init-fn [world _game]
  (-> world
      (esse ::time/now {::world-mutator world-mutator 
                        ::tick 0
                        ::tick-progress 0})
      (esse :one {::dialogue "hello jank!" ::progress 5})))

(defn render!
  [{world ::world/this}
   ^(:* cpp/SDL_Renderer) renderer
   ^(:* cpp/TTF_Font) font]
  (when-let [{:keys [dialogue progress]} (utils/query-one world ::animate-dialogue)]
    (let [black    (cpp/SDL_Color 255 255 255 255)
          w        (cpp/int)
          h        (cpp/int)
          dialogue (subs dialogue 0 (min (max progress 0) (count dialogue)))
          _        (cpp/TTF_GetStringSize font dialogue (count dialogue) (cpp/& w) (cpp/& h))
          surface  (cpp/TTF_RenderText_Blended font dialogue (count dialogue) black)
          texture  (cpp/SDL_CreateTextureFromSurface renderer surface)
          dst-rect (cpp/SDL_FRect 120.0 240.0 w h)]
      
    (cpp/SDL_DestroySurface surface)
    (cpp/SDL_RenderTexture renderer texture cpp/nullptr (cpp/& dst-rect))
    (cpp/SDL_DestroyTexture texture))))

(def system
  {::world/init-fn init-fn
   ::world/rules rules})

(comment
  
  (add-tap #(def debug %))
  debug
  
  (reset! world-mutator
          (fn [world]
            (-> world
                (esse ::time/now {::tick-length 0.05})
                (esse :one {::dialogue "hello jank!" ::progress 1}))))

  :-)
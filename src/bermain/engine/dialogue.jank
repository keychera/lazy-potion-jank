(ns bermain.engine.dialogue
  (:require
   [bermain.engine.macros :refer [s->]]
   [bermain.engine.time :as time]
   [bermain.engine.utils :as utils]
   [bermain.engine.world :as world :refer [esse]]
   [bermain.sdl3.text :as text]
   [odoyle.rules :as o]))

(def rules
  (o/ruleset
   {::dialogue-tick
    [:what
     [::time/now ::time/delta dt]
     [::time/now ::tick-length tick-length {:then false}]
     [::time/now ::tick-progress tick-progress {:then false}]
     [::time/now ::tick tick {:then false}]
     :then
     (if (< tick-progress tick-length)
       (s-> session (o/insert ::time/now ::tick-progress (+ tick-progress dt)))
       (s-> session (o/insert ::time/now {::tick-progress 0
                                          ::tick (inc tick)})))]

    ::animate-dialogue
    [:what
     [::time/now ::tick tick]
     [esse-id ::dialogue dialogue]
     [esse-id ::progress progress {:then false}]
     :then
     (s-> session (o/insert esse-id ::progress (inc progress)))]}))

(defn init-fn [world _game]
  (-> world
      (esse ::time/now {::tick 0 ::tick-progress 0})
      (esse :one {::dialogue "hello jank!" ::progress 5})))

(defn render!
  [{world ::world/this :as game}]
  (when-let [{:keys [dialogue progress]} (utils/query-one world ::animate-dialogue)]
    (let [dialogue (subs dialogue 0 (min (max progress 0) (count dialogue)))
          text     (doto (cpp/unbox (:* cpp/TTF_Text) (::text/text game))
                     (cpp/TTF_SetTextString dialogue 0)
                     (cpp/TTF_SetTextColor 255 255 255 cpp/SDL_ALPHA_OPAQUE))]
      (cpp/TTF_DrawRendererText text 120.0 240.0))))

(defn get-system []
  {::world/init-fn init-fn
   ::world/rules rules})

(comment
  (require '[bermain.engine.world-mutator :refer [mutate-world! debug-tap]])

  debug-tap

  (mutate-world!
   (fn [world]
     (-> world
         (esse ::time/now {::tick-length 0.05})
         (esse :one {::dialogue "hello jank!" ::progress -1}))))

  :-)

(ns bermain.engine.world
  (:require
   [odoyle.rules :as o]))

(defn prepare-world [game all-rules init-fns]
  (let [world  (reduce o/add-rule (o/->session) all-rules)
        world' (reduce (fn [w' init-fn] (init-fn w' game)) world init-fns)]
    world'))

(defn init-world [game system-coll]
  (let [systems    (into [] (mapcat (fn [sys] (if (vector? sys) sys [sys]))) system-coll)
        all-rules  (into [] (mapcat ::rules) systems)
        init-fns   (into [] (comp (map ::init-fn) (filter some?)) systems)]
    (assoc (assoc game ::this (prepare-world game all-rules init-fns))
           ::init-fns init-fns)))

(defn esse
  "insert an esse given the facts in the shape of maps of attr->value.
   this fn is merely sugar, spice, and everything nice"
  [world esse-id facts]
  (o/insert world esse-id facts))

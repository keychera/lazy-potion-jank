(ns bermain.engine.time
  (:include
   "SDL3/SDL.h")
  (:require
   [bermain.engine.world :as world]
   [odoyle.rules :as o]))

(defn prepare [game]
  (assoc game
         ::one-second 0
         ::frame-count 0))

(defn update-time [{:keys [::one-second ::frame-count] :as game}]
  (let [total (/ (cpp/SDL_GetTicks) 1000.0)
        delta (- total (::total game 0))
        game' (-> (assoc game ::total total ::delta delta)
                  (update ::world/this o/insert ::now {::total total ::delta delta}))] 
    (if (< one-second 1)
      (-> game'
          (assoc ::one-second (+ one-second delta) ::frame-count (inc frame-count)))
      (-> game'
          (assoc ::one-second 0 ::frame-count 0)
          (update ::world/this o/insert ::now {::last-fps frame-count})))))

(def rules
  (o/ruleset
   {::time
    [:what
     [::now ::total tt]
     [::now ::delta dt]]

    ::debug-fps
    [:what
     [::now ::last-fps last-fps]]}))

(defn get-system []
  {::world/rules rules})

(ns bermain.engine.systems
  (:require
   [bermain.engine.audio :as audio]
   [bermain.engine.dialogue :as dialogue]
   [bermain.engine.time :as time]
   [bermain.engine.world-mutator :as world-mutator]))

(defn get-all []
  [(time/get-system)
   (dialogue/get-system)
   (audio/get-system)
   
   #_dev
   (world-mutator/get-system)])

(ns bermain.engine.utils
  (:require
   [odoyle.rules :as o]))

(defmacro s->
  "Thread like `->` but always ends with (odoyle.rules/reset!)."
  [x & forms]
  `(-> ~x ~@forms o/reset!))

(defn query-one 
  "o/query-all with assumption that it only match either one or zero match" 
  [odoyle-session rule-name]
  (first (o/query-all odoyle-session rule-name)))

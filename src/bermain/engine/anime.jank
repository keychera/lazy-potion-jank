(ns bermain.engine.anime
  (:include
   "choreograph/Choreograph.h"
   "choreograph/Easing.h")
  (:require
   [bermain.engine.time :as time]))

(cpp/raw
 "using namespace choreograph;
  
  template <typename T, typename... Args>
  void thenHold(Sequence<T>& sequence, Args&&... args) {
      sequence.template then<Hold>(std::forward<Args>(args)...);
  }
  
  template <typename T, typename... Args>
  void thenRampTo(Sequence<T>& sequence, Args&&... args) {
      sequence.template then<RampTo>(std::forward<Args>(args)...);
  }
  
  using CSI = Sequence<int>;")

;; issue = if I instantiate this inside prepare, put it in cpp/box, assoc to keyword in game 
;; it crash when cpp/unboxed cpp/*'ed and call its functiom 

(def target-fps 12)
(def frame-duration (/ 1.0 target-fps))
(def frame-num 11)
(def anime-duration (* frame-num frame-duration))

(defn prepare [game]
  (let [theanime (cpp/new (choreograph.Sequence float) 0.0)]
    (doto (cpp/* theanime)
      (cpp/thenRampTo 20.0 4.0 (cpp/choreograph.EaseInOutQuad))
      (cpp/thenRampTo 0.0 4.0 (cpp/choreograph.EaseInOutQuad)))
    (assoc game
           ::timer 0.0 ::frame 0
           ::theanime (cpp/box theanime))))

(defn advance [{:keys [::timer] :as game}]
  (let [delta  (::time/delta game)
        timer' (+ timer delta)
        timer' (if (> timer' anime-duration)
                 (mod timer' anime-duration)
                 timer')
        theanime (cpp/unbox (:* (choreograph.Sequence float)) (::theanime game))
        frame (cpp/floor (/ timer' frame-duration))
        animeval (.getValueWrapped (cpp/* theanime) (::time/total game))]
    (tap> [(::time/total game) animeval])
    (assoc game
           ::timer timer' ::frame frame
           ::animeval animeval)))

(defn clean! [_game])

(comment
  (require '[bermain.engine.world-mutator :refer [debug-tap]]
           'jank.compiler)
  debug-tap

  (let [sequence (-> (#cpp (choreograph.Sequence int) 0)
                     (cpp/thenHold 20 10)
                     (cpp/thenRampTo 99 10))]
    (-> sequence (.getValueWrapped 12)))

  (jank.compiler/native-source
   '(let [theanime (cpp/new (choreograph.Sequence int) 0)]
      (#cpp (CSI.then choreograph.RampTo) (cpp/* theanime) 20 50)))

  (jank.compiler/native-source
   '(let [theanime (cpp/new (choreograph.Sequence int) 0)]
      (-> (cpp/* theanime)
          (cpp/thenRampTo 20 10)
          (cpp/thenHold 99 10))))

  :-)
(ns bermain.engine.anime
  (:include
   "choreograph/Choreograph.h")
  (:require
   [bermain.engine.time :as time]))

(cpp/raw
 "using namespace choreograph;
  
  template <typename T, typename... Args>
  auto thenHold(Sequence<T>& sequence,  Args&&... args) {
      return sequence.template then<Hold>(std::forward<Args>(args)...);
  }
  
  template <typename T, typename... Args>
  auto thenRampTo(Sequence<T>& sequence,  Args&&... args) {
      return sequence.template then<RampTo>(std::forward<Args>(args)...);
  }
  
  auto theanime = Sequence<int>(0).then<RampTo>(20, 50);")

;; issue = if I instantiate this inside prepare, put it in cpp/box, assoc to keyword in game 
;; it crash when cpp/unboxed cpp/*'ed and call its functiom 

(def target-fps 12)
(def frame-duration (/ 1.0 target-fps))
(def frame-num 11)
(def anime-duration (* frame-num frame-duration))

(defn prepare [game]
  (assoc game ::timer 0.0 ::frame 0))

(defn advance [{:keys [::timer] :as game}]
  (let [delta  (::time/delta game)
        timer' (+ timer delta)
        timer' (if (> timer' anime-duration)
                 (mod timer' anime-duration)
                 timer')
        frame  (cpp/floor (/ timer' frame-duration))]
    (tap> (.getValueWrapped cpp/theanime (::time/total game)))
    (assoc game ::timer timer' ::frame frame)))

(defn clean! [_game])

(comment
  (require '[bermain.engine.world-mutator :refer [debug-tap]])
  debug-tap

  (let [sequence (-> (#cpp (choreograph.Sequence int) 0)
                     (cpp/thenHold 3 3)
                     (cpp/thenRampTo 20 6400))]
    (-> sequence (.getValueWrapped 6)))

  :-)
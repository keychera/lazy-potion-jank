(ns bermain.sdl3.mixer
  (:include
   "SDL3_mixer/SDL_mixer.h")
  (:require
   [bermain.sdl3.common :refer [must-be-true must-be-some]]))

(defn init [game]
  (must-be-true (cpp/MIX_Init))

  (let [mixer (must-be-some (cpp/MIX_CreateMixerDevice cpp/SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK cpp/nullptr))
        audio (must-be-some (cpp/MIX_LoadAudio mixer "res/switch11.ogg" true))
        track (must-be-some (cpp/MIX_CreateTrack mixer))]
    (cpp/MIX_SetTrackAudio track audio)
    (assoc game ::track (cpp/box track))))

(defn play-that-track! [game]
  (let [track (cpp/unbox (:* cpp/MIX_Track) (::track game))]
    (cpp/MIX_PlayTrack track 0)))

(defn clean! [_game]
  (cpp/MIX_Quit))

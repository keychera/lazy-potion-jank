(ns bermain.sdl3.text
  (:include
   "SDL3_ttf/SDL_ttf.h")
  (:require
   [bermain.sdl3.common :refer [must-be-some throw-sdl-error]]))

(defn init [game]
  (let [ret (cpp/TTF_Init)]
    (when (< ret 0)
      (throw-sdl-error "TTF_Init error")))

  (let [ttf-font (must-be-some (cpp/TTF_OpenFont "res/CardboardCrown.ttf" 32))]
    (assoc game ::ttf-font (cpp/box ttf-font))))

(defn render! [game]
  (let [white    (cpp/SDL_Color 200 200 200 0)
        renderer (cpp/unbox (:* cpp/SDL_Renderer) (:sdl-renderer game))
        font     (cpp/unbox (:* cpp/TTF_Font) (::ttf-font game))
        message  "Hello jank + SDL3_ttf !"
        surface  (cpp/TTF_RenderText_Blended font message (count message) white)
        texture  (cpp/SDL_CreateTextureFromSurface renderer surface)
        player   (:player game)
        dst-rect (cpp/SDL_FRect (:x player) (+ (:y player) 60) 600.0 67.0)]
    (cpp/SDL_DestroySurface surface)
    (cpp/SDL_RenderTexture renderer texture cpp/nullptr (cpp/& dst-rect))
    (cpp/SDL_DestroyTexture texture)))

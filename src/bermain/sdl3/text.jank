(ns bermain.sdl3.text
  (:include
   "cmath"
   "SDL3_ttf/SDL_ttf.h")
  (:require
   [bermain.sdl3.error :refer [must-be-true must-be-some]]))

;; resource
;; https://github.com/libsdl-org/SDL_ttf/blob/main/examples/showfps.c

(defn init [game]
  (must-be-true (cpp/TTF_Init))

  (let [renderer (cpp/unbox (:* cpp/SDL_Renderer) (:sdl-renderer game))
        engine   (must-be-some (cpp/TTF_CreateRendererTextEngine renderer))
        font     (must-be-some (cpp/TTF_OpenFont "res/fonts/CardboardCrown/CardboardCrown.ttf" 32))
        text     (must-be-some (cpp/TTF_CreateText engine font "empty" 0))]
    (assoc game 
           ::engine (cpp/box engine)
           ::font   (cpp/box font)
           ::text   (cpp/box text))))

(def message "Hello jank + SDL3_ttf!")

(defn render! [game]
  (let [text   (doto (cpp/unbox (:* cpp/TTF_Text) (::text game))
                 (cpp/TTF_SetTextString message 0)
                 (cpp/TTF_SetTextColor 0 0 0 cpp/SDL_ALPHA_OPAQUE))
        player (:player game)]
    (cpp/TTF_DrawRendererText text (:x player) (+ (:y player) 60))))

(defn clean! [game]
  (let [text   (cpp/unbox (:* cpp/TTF_Text) (::text game))
        engine (cpp/unbox (:* cpp/TTF_TextEngine) (::engine game))
        font   (cpp/unbox (:* cpp/TTF_Font) (::font game))]
    (cpp/TTF_DestroyText text)
    (cpp/TTF_DestroyRendererTextEngine engine)
    (cpp/TTF_CloseFont font)))

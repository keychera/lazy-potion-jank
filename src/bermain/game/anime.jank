(ns bermain.game.anime
  (:include "cmath")
  (:require
   [bermain.sdl3.time :as time]))

(def target-fps 12)
(def frame-duration (/ 1.0 target-fps))
(def frame-num 11)
(def anime-duration (* frame-num frame-duration))

(defn init [game]
  (assoc game ::timer 0.0 ::frame 0))

(defn advance [{:keys [::time/delta ::timer] :as game}]
  (let [timer' (+ timer delta)
        timer' (if (> timer' anime-duration)
                 (mod timer' anime-duration)
                 timer')
        frame  (cpp/floor (/ timer' frame-duration))]
    #_{:clj-kondo/ignore [:inline-def]}
    (def debug game)
    (assoc game ::timer timer' ::frame frame)))

(comment

  ((juxt ::frame ::timer) debug)
  
  :-)